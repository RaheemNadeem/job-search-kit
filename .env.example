# Copy to .env and fill in. .env is git-ignored — never commit it.

# ── AI model (any OpenAI-compatible API) ─────────────────────────────────────
# DeepSeek (cheap, good):   LLM_BASE_URL=https://api.deepseek.com          LLM_MODEL=deepseek-chat
# OpenAI:                   LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
# OpenRouter (any model):   LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=anthropic/claude-sonnet-4.5
# Ollama (free, local):     LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=qwen2.5:14b   (no key needed)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Optional: different models for scoring (cheap) and resume writing (better).
# LLM_RATING_MODEL=
# LLM_RESUME_MODEL=
# Set to 0 if your provider rejects response_format=json_object.
# LLM_JSON_MODE=1

# ── Dashboard server ─────────────────────────────────────────────────────────
DASHBOARD_PORT=7867
# 127.0.0.1 = only this computer. Use 0.0.0.0 if n8n runs in Docker, and set a token.
DASHBOARD_HOST=127.0.0.1
# Required for any request that doesn't come from this computer (e.g. n8n in Docker).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DASHBOARD_TOKEN=

# ── Pipeline ─────────────────────────────────────────────────────────────────
# Write a tailored resume automatically for new jobs scoring at least RESUME_MIN_SCORE.
AUTO_RESUME=0
RESUME_MIN_SCORE=3.5
# Minutes to wait for you to solve a captcha / sign in before skipping (0 = never wait).
CAPTCHA_WAIT_MIN=10
# Stealth browser: cloakbrowser (default) or camoufox.
# BROWSER_ENGINE=cloakbrowser
# Where job folders, the queue and the browser session live.
# DATA_DIR=data

# ── Notifications (optional) ─────────────────────────────────────────────────
# Import summaries and "captcha needs solving" alerts are POSTed here as JSON.
# Point it at the n8n "Notifications" workflow webhook.
NOTIFY_WEBHOOK_URL=
